{
  "id": "sort-my-care",
  "title": "Sort My Care",
  "example": "GP near E8 3GT",
  "blurb": "Find NHS and public health services near a postcode — GPs, pharmacies, hospitals, dentists.",
  "render": { "mode": "corpus" },
  "keywords": ["gp", "nhs", "clinic", "pharmacy", "chemist", "hospital", "dentist", "doctor", "health service", "care home", "a&e"],
  "stages": [
    {
      "name": "plan",
      "kind": "plan",
      "events": [
        { "type": "STEP_STARTED", "text": "read your postcode" },
        { "type": "TEXT_MESSAGE_CONTENT", "text": "Finding public health & care services near you…" }
      ]
    },
    {
      "name": "query",
      "kind": "tool",
      "exec": "query_corpus",
      "corpus": "care",
      "events": [
        { "type": "TOOL_CALL_START", "text": "fetch_care_services" },
        { "type": "TOOL_CALL_END", "text": "fetch_care_services" }
      ]
    }
  ]
}
